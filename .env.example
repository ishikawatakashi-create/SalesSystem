# ============================================================
# 環境変数テンプレート
# コピーして .env.local を作成し、値を設定すること。
# 実際の値は絶対にリポジトリへコミットしない。
# ============================================================

# ---- 公開可(ブラウザに渡る) ----
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- サーバー専用(絶対に NEXT_PUBLIC_ を付けない) ----
# Supabase Secret key (sb_secret_...) — RLSをバイパスする。取り扱い厳重注意
SUPABASE_SECRET_KEY=
# Authentication > Sign In / Providers > Email > Email OTP Expirationと同じ秒数。
# 招待リンクとuser_invitations.expires_atを一致させるため必須(推測値を設定しない)。
SUPABASE_EMAIL_OTP_EXPIRY_SECONDS=
# Notion internal integration token(Phase 1 Notion接続ステップで使用)
NOTION_TOKEN=
# Notion Webhook 署名シークレット(任意の上書き)。
# 通常は verification handshake で受け取った verification_token を
# Supabase Vault(notion_webhook_verification_token) に保存して使う。
# 設定されている場合は Vault より優先する。
NOTION_WEBHOOK_SECRET=
# 旧案のアプリ内暗号化キー。Vault 利用時は不要(設定しなくてよい)。
# WEBHOOK_TOKEN_ENCRYPTION_KEY=
# ジョブワーカー起動の認証(pg_cron/pg_netからのリクエスト検証)
CRON_SECRET=

# 初回管理者bootstrap許可メール(active adminが0件のときのみ有効)
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# Notionセットアップ親ページID(ハードコード禁止。CLI引数でも可)
NOTION_PARENT_PAGE_ID=

# ---- Notion データソースID(scripts/setup-notion.ts が出力) ----
NOTION_DS_CUSTOMERS=
NOTION_DS_CONTACTS=
NOTION_DS_DEALS=
NOTION_DS_ACTIVITIES=
NOTION_DS_CONTRACTS=
NOTION_DS_COMPLAINTS=
NOTION_DS_ACTIONS=
NOTION_DS_MASTERS=
NOTION_DS_STAFF=
