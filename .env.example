# ============================================================
# 環境変数テンプレート
# コピーして .env.local を作成し、値を設定すること。
# 実際の値は絶対にリポジトリへコミットしない。
# ============================================================

# ---- 公開可(ブラウザに渡る) ----
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- サーバー専用(絶対に NEXT_PUBLIC_ を付けない) ----
# Supabase Secret key (sb_secret_...) — RLSをバイパスする。取り扱い厳重注意
SUPABASE_SECRET_KEY=
# Notion internal integration token(Phase 1 Notion接続ステップで使用)
NOTION_TOKEN=
# Notion Webhook検証シークレット
NOTION_WEBHOOK_SECRET=
# ジョブワーカー起動の認証(pg_cron/pg_netからのリクエスト検証)
CRON_SECRET=

# ---- Notion データソースID(scripts/setup-notion.ts が出力) ----
NOTION_DS_CUSTOMERS=
NOTION_DS_CONTACTS=
NOTION_DS_DEALS=
NOTION_DS_ACTIVITIES=
NOTION_DS_CONTRACTS=
NOTION_DS_COMPLAINTS=
NOTION_DS_ACTIONS=
NOTION_DS_MASTERS=
NOTION_DS_STAFF=
